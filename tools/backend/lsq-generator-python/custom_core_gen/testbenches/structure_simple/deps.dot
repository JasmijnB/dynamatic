digraph dependencies {
    // Load node (predecessor queue — the load that must complete before the store)
    ld0 [config_id=0];

    // Store node (successor queue — the store that must wait for the load)
    st0 [config_id=1];

    // WAR dependency: the load to address X must retire before the store to X may issue
    ld0 -> st0 [config_id=0];
}
